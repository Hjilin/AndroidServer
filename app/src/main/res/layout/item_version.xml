<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:paddingVertical="6dp">

    <TextView android:id="@+id/tv_version_name" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1"
        android:textSize="13sp" android:textColor="@color/text_primary" />

    <TextView android:id="@+id/btn_version_action" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textSize="12sp" android:padding="4dp"
        android:clickable="true" android:focusable="true" />
</LinearLayout>